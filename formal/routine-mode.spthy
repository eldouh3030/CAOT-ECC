/*
 * CAOT-ECC v2 - symbolic security model (Tamarin prover, Dolev-Yao attacker)
 *
 *  Critical mode : one-pass packet, ephemeral X25519, HKDF, AEAD, Ed25519 per packet
 *  Routine mode  : signed R_INIT, forward-secure HKDF chain, AEAD per packet,
 *                  one signature per window over a running hash
 *
 *  AEAD with associated data is modelled as senc(<m, hdr>, k): the receiver
 *  only accepts a ciphertext that decrypts under k AND carries the expected
 *  header, which is the standard symbolic model of authenticated encryption.
 *  The timestamp/nonce replay cache of the gateway is modelled by the
 *  Unique restriction on (device, nonce).
 *
 *  The HKDF chain ck_{i+1} = KDF(ck_i) is written chain(ck_0, i). Chain keys
 *  are one-way: an explicit attacker rule lets anyone holding chain(ck_0, i)
 *  derive chain(ck_0, i+1), but never chain(ck_0, i-1).
 *
 *  Run:  tamarin-prover --prove routine-mode.spthy
 */
theory CAOT_ECC_v2_Routine
begin

builtins: diffie-hellman, signing, hashing, symmetric-encryption, natural-numbers
functions: hkdf/3, kdfm/1, chain/2

restriction Equality:   "All x y #i. Eq(x, y) @ #i ==> x = y"
restriction Unique:     "All x #i #j. Uniq(x) @ #i & Uniq(x) @ #j ==> #i = #j"
restriction OneKeyG:    "All x #i #j. KeyG(x) @ #i & KeyG(x) @ #j ==> #i = #j"
restriction OneKeyD:    "All x #i #j. KeyD(x) @ #i & KeyD(x) @ #j ==> #i = #j"

/* ------------------------------------------------------------------ setup */
rule Gateway_Setup:
    [ Fr(~skG) ] --[ KeyG($G) ]-> [ !LtkG($G, ~skG), !PkG($G, 'g'^~skG), Out('g'^~skG) ]

rule Device_Setup:
    [ Fr(~skD) ] --[ KeyD($D) ]-> [ !LtkD($D, ~skD), !PkD($D, pk(~skD)), Out(pk(~skD)) ]

/* long-term key compromise (used to state forward secrecy and KCI) */
rule Reveal_Gateway: [ !LtkG(G, sk) ] --[ RevG(G) ]-> [ Out(sk) ]
rule Reveal_Device:  [ !LtkD(D, sk) ] --[ RevD(D) ]-> [ Out(sk) ]

/* ------------------------------------------------------------- routine mode */
rule R_Init_Send:
    let E   = 'g'^~e
        hdr = <'I', $D, $G, ~sid, E, ~n, ~t>
        ck0 = hkdf(pkG^~e, ~n, hdr)
        s   = sign(<'I', hdr>, skD)
    in
    [ !LtkD($D, skD), !PkG($G, pkG), Fr(~e), Fr(~n), Fr(~sid), Fr(~t) ]
  --[ RInitSent($D, $G, ~sid), DevInit($D, $G, ~sid, ck0) ]->
    [ DevSess($D, $G, ~sid, ck0, %1, h(<'R0', hdr>)), Out(<hdr, s>) ]

rule R_Init_Recv:
    let hdr = <'I', $D, $G, sid, E, n, t>
        ck0 = hkdf(E^~skG, n, hdr)
    in
    [ !LtkG($G, ~skG), !PkD($D, pkD), In(<hdr, s>) ]
  --[ Eq(verify(s, <'I', hdr>, pkD), true),
      Uniq(<'nonce', $D, n>), Uniq(<'sid', $D, sid>),
      RInitRecv($D, $G, sid), SrvInit($D, $G, sid, ck0) ]->
    [ SrvSess($D, $G, sid, ck0, %1, h(<'R0', hdr>)) ]

rule R_Data_Send:
    let hdr = <'D', $D, ~sid, %i, ~t>
        c   = senc(<~m, hdr>, kdfm(chain(ck0, %i)))
    in
    [ DevSess($D, $G, ~sid, ck0, %i, rh), Fr(~m), Fr(~t) ]
  --[ RSent($D, $G, ~sid, ~m, %i), RSentK(ck0, %i), DevStep($D, $G, ~sid, ck0), DevIdx(ck0, %i) ]->
    [ DevSess($D, $G, ~sid, ck0, %i %+ %1, h(<rh, hdr, h(c)>)), Out(<hdr, c>) ]

rule R_Data_Recv:
    let hdr = <'D', $D, sid, %i, t>
        c   = senc(<m, hdr>, kdfm(chain(ck0, %i)))
    in
    [ SrvSess($D, $G, sid, ck0, %i, rh), In(<hdr, c>) ]
  --[ RRecv($D, $G, sid, m, %i), RRecvK(ck0, %i), SrvStep($D, $G, sid, ck0), SrvIdx(ck0, %i) ]->
    [ SrvSess($D, $G, sid, ck0, %i %+ %1, h(<rh, hdr, h(c)>)) ]

rule R_Window_Send:
    let w = <'W', $D, ~sid, ~t>
        s = sign(<'W', w, rh>, skD)
    in
    [ DevSess($D, $G, ~sid, ck0, %i, rh), !LtkD($D, skD), Fr(~t) ]
  --[ WinSent($D, ~sid, rh), DevStep($D, $G, ~sid, ck0) ]->
    [ DevSess($D, $G, ~sid, ck0, %i, h(<'R0', s>)), Out(<w, s>) ]

rule R_Window_Recv:
    let w = <'W', $D, sid, t>
    in
    [ SrvSess($D, $G, sid, ck0, %i, rh), !PkD($D, pkD), In(<w, s>) ]
  --[ Eq(verify(s, <'W', w, rh>, pkD), true), WinAccepted($D, sid, rh), SrvStep($D, $G, sid, ck0) ]->
    [ SrvSess($D, $G, sid, ck0, %i, h(<'R0', s>)) ]

/* one-wayness of the chain: anyone can step forward */
rule Chain_Forward:
    [ In(chain(x, %i)) ] --[ ]-> [ Out(chain(x, %i %+ %1)) ]

/* session-state compromise: the current chain key leaks */
rule Reveal_Device_State:
    [ DevSess($D, $G, ~sid, ck0, %i, rh) ] --[ RevState(~sid), RevChain(ck0), RevChainAt(ck0, %i), DevRevAt(ck0, %i), DevStep($D, $G, ~sid, ck0) ]->
    [ DevSess($D, $G, ~sid, ck0, %i, rh), Out(chain(ck0, %i)) ]
rule Reveal_Server_State:
    [ SrvSess($D, $G, sid, ck0, %i, rh) ] --[ RevState(sid), RevChain(ck0), RevChainAt(ck0, %i), SrvRevAt(ck0, %i), SrvStep($D, $G, sid, ck0) ]->
    [ SrvSess($D, $G, sid, ck0, %i, rh), Out(chain(ck0, %i)) ]

/* proof-search tactic: solve knowledge/freshness goals before unrolling the
   session-state loop, which otherwise diverges */
tactic: states_last
presort: s
prio:
    regex "Fr\("
    regex "!LtkD\("
    regex "!KU\( ~"
    regex "!KU\( sign"
deprio:
    regex "Sess\("

/* ================================================================ lemmas */

/* invariants: every session state descends from its own R_INIT */
lemma dev_state_origin [reuse, use_induction]:
  "All D G sid ck0 #a. DevStep(D, G, sid, ck0) @ #a ==> Ex #b. DevInit(D, G, sid, ck0) @ #b & #b < #a"

/* invariant: knowing any chain key requires the chain seed or a state reveal */
lemma chain_key_origin [reuse, use_induction]:
  "All x %i #a. KU(chain(x, %i)) @ #a ==>
      (Ex #b. KU(x) @ #b & #b < #a) | (Ex #r. RevChain(x) @ #r & #r < #a)"

/* R2 forward secrecy of the key chain (one-wayness): a chain key at index i can only
   be obtained from the seed or from a state revealed at an index <= i; a state revealed
   later (higher index) never yields earlier message keys. States only move forward by
   construction (every rule writes index i or i+1). */
lemma chain_key_index [reuse, use_induction]:
  "All x %i #a. KU(chain(x, %i)) @ #a ==>
      (Ex #b. KU(x) @ #b & #b < #a) | (Ex %j #r. RevChainAt(x, %j) @ #r & #r < #a & (%j = %i | %j << %i))"

lemma srv_state_origin [reuse, use_induction]:
  "All D G sid ck0 #a. SrvStep(D, G, sid, ck0) @ #a ==> Ex #b. SrvInit(D, G, sid, ck0) @ #b & #b < #a"


lemma routine_executable [heuristic={states_last}]: exists-trace
  "Ex D G sid m %i #a. RRecv(D, G, sid, m, %i) @ #a
     & not (Ex X #r. RevG(X) @ #r) & not (Ex X #r. RevD(X) @ #r) & not (Ex X #r. RevState(X) @ #r)"

/* R4 window non-repudiation */
lemma window_non_repudiation [heuristic={states_last}]:
  "All D sid rh #a. WinAccepted(D, sid, rh) @ #a ==>
      (Ex #b. WinSent(D, sid, rh) @ #b & #b < #a) | (Ex #r. RevD(D) @ #r & #r < #a)"

/* R1 confidentiality of routine payloads */
lemma routine_secrecy [heuristic={states_last}]:
  "All D G sid m %i #a. RSent(D, G, sid, m, %i) @ #a ==>
      not (Ex #k. K(m) @ #k) | (Ex #r. RevG(G) @ #r) | (Ex #r. RevState(sid) @ #r)"

/* R3 data-origin authentication of routine packets */
lemma routine_authentication [heuristic={states_last}]:
  "All D G sid m %i #a. RRecv(D, G, sid, m, %i) @ #a ==>
      (Ex #b. RSent(D, G, sid, m, %i) @ #b & #b < #a)
      | (Ex #r. RevD(D) @ #r & #r < #a) | (Ex #r. RevG(G) @ #r) | (Ex #r. RevState(sid) @ #r)"

end
